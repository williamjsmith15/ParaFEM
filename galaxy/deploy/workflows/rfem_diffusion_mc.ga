            },
            "inputs": [],
            "label": "Solve MC Instances",
            "outputs": [
                {
                    "name": "output_res",
                    "type": "txt"
                },
                {
                    "name": "output_ensi",
                    "type": "tar.gz"
                }
            ],
            "position": {
                "left": 750,
                "top": 200
            },
            "tool_id": "gdps_rfemsolve_thermal",
            "tool_state": "{}",
            "type": "tool"
        },
        "4": {
