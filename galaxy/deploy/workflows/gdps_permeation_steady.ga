{
    "a_galaxy_workflow": "true",
    "annotation": "Steady-state hydrogen permeation: mesh -> thermal solve -> temperature-dependent D(T) and Sievert BCs -> diffusion solve -> VTU.",
    "format-version": "0.1",
    "name": "Steady-State Hydrogen Permeation (Phase 5)",
    "steps": {
        "0": {
            "annotation": "Upstream Hydrogen Pressure (Pa)",
            "id": 0,
            "input_connections": {},
            "inputs": [{"description": "Upstream Pressure (Pa)", "name": "upstream_p"}],
            "label": "Upstream Pressure (Pa)",
            "name": "Input parameter",
            "type": "parameter_input",
            "tool_state": "{\"default\": 100000.0, \"parameter_type\": \"float\", \"optional\": false}",
            "uuid": "uuid-0"
        },
        "1": {
            "annotation": "Downstream Hydrogen Pressure (Pa)",
            "id": 1,
            "input_connections": {},
            "inputs": [{"description": "Downstream Pressure (Pa)", "name": "downstream_p"}],
            "label": "Downstream Pressure (Pa)",
            "name": "Input parameter",
            "type": "parameter_input",
            "tool_state": "{\"default\": 0.0, \"parameter_type\": \"float\", \"optional\": false}",
            "uuid": "uuid-1"
        },
        "2": {
            "annotation": "Material selection from database",
            "id": 2,
            "input_connections": {},
            "inputs": [{"description": "Material (iron/copper/tungsten)", "name": "material"}],
            "label": "Material",
            "name": "Input parameter",
            "type": "parameter_input",
            "tool_state": "{\"default\": \"iron\", \"parameter_type\": \"text\", \"optional\": false}",
            "uuid": "uuid-2"
        },
        "3": {
            "annotation": "Mesh Generation (Structured Hex)",
            "content_id": "gdps_meshgen_box",
            "id": 3,
            "input_connections": {},
            "inputs": [],
            "label": "1. Mesh Generation",
            "name": "ParaFEM Box Mesh Generator",
            "tool_id": "gdps_meshgen_box",
            "tool_state": "{\"nxe\": \"10\", \"nye\": \"10\", \"nze\": \"10\", \"dim_x\": \"1.0\", \"dim_y\": \"1.0\", \"dim_z\": \"0.01\"}",
            "type": "tool",
            "uuid": "uuid-3"
        },
        "4": {
            "annotation": "Thermal BCs for mesh",
            "content_id": "gdps_bc_thermal",
            "id": 4,
            "input_connections": {
                "mesh_d": {"id": 3, "output_name": "output_d"}
            },
            "inputs": [],
            "label": "2. Thermal BCs",
            "name": "ParaFEM Thermal BC Generator",
            "tool_id": "gdps_bc_thermal",
            "tool_state": "{\"kx\": \"50.0\", \"ky\": \"50.0\", \"kz\": \"50.0\", \"zone_config\": \"[{\\\"axis_min\\\": 0.0, \\\"axis_max\\\": 0.1, \\\"temperature\\\": 800.0}, {\\\"axis_min\\\": 0.9, \\\"axis_max\\\": 1.0, \\\"temperature\\\": 300.0}]\"}",
            "type": "tool",
            "uuid": "uuid-4"
        },
        "5": {
            "annotation": "Steady-state thermal solve",
            "content_id": "gdps_steady_thermal",
            "id": 5,
            "input_connections": {
                "d_file": {"id": 4, "output_name": "output_d"},
                "dat_file": {"id": 4, "output_name": "output_dat"},
                "fix_file": {"id": 4, "output_name": "output_fix"},
                "bnd_file": {"id": 4, "output_name": "output_bnd"}
            },
            "inputs": [],
            "label": "3. Thermal Solver",
            "name": "ParaFEM Steady-State Thermal Solver",
            "tool_id": "gdps_steady_thermal",
            "tool_state": "{}",
            "type": "tool",
            "uuid": "uuid-5"
        },
        "6": {
            "annotation": "Extract temperature field for coupling",
            "content_id": "gdps_extract_ic",
            "id": 6,
            "input_connections": {
                "input_path": {"id": 5, "output_name": "output_ensi"}
            },
            "inputs": [],
            "label": "4. Extract Temperature",
            "name": "ParaFEM Extract IC",
            "tool_id": "gdps_extract_ic",
            "tool_state": "{}",
            "type": "tool",
            "uuid": "uuid-6"
        },
        "7": {
            "annotation": "Compute temperature-dependent diffusivity field",
            "content_id": "gdps_compute_diffusivity",
            "id": 7,
            "input_connections": {
                "mesh_d": {"id": 4, "output_name": "output_d"},
                "dat_file": {"id": 4, "output_name": "output_dat"},
                "temp_mode|temp_field": {"id": 6, "output_name": "output_ini"},
                "material_type|material": {"id": 2, "output_name": "output"}
            },
            "inputs": [],
            "label": "5. Diffusivity Field",
            "name": "ParaFEM Diffusivity Field",
            "tool_id": "gdps_compute_diffusivity",
            "tool_state": "{\"temp_mode\": {\"mode\": \"field\"}, \"material_type\": {\"source\": \"database\"}}",
            "type": "tool",
            "uuid": "uuid-7"
        },
        "8": {
            "annotation": "Mesh Import to handle modified .d and .nset",
            "content_id": "gdps_mesh_import",
            "id": 8,
            "input_connections": {
                "mesh_inp": {"id": 7, "output_name": "output_d"}
            },
            "inputs": [],
            "label": "6. Re-import Mesh",
            "name": "ParaFEM Mesh Import",
            "tool_id": "gdps_mesh_import",
            "tool_state": "{}",
            "type": "tool",
            "uuid": "uuid-8"
        },
        "9": {
            "annotation": "Sievert's Law concentration BCs",
            "content_id": "gdps_sievert_bc",
            "id": 9,
            "input_connections": {
                "mesh_d": {"id": 8, "output_name": "output_d"},
                "nset_file": {"id": 8, "output_name": "output_nset"},
                "upstream_p": {"id": 0, "output_name": "output"},
                "downstream_p": {"id": 1, "output_name": "output"},
                "material_type|material": {"id": 2, "output_name": "output"},
                "temp_mode|temp_field": {"id": 6, "output_name": "output_ini"}
            },
            "inputs": [],
            "label": "7. Sievert BCs",
            "name": "ParaFEM Sievert's Law BC",
            "tool_id": "gdps_sievert_bc",
            "tool_state": "{\"temp_mode\": {\"mode\": \"field\"}, \"material_type\": {\"source\": \"database\"}, \"pressure_type\": {\"type\": \"static\"}}",
            "type": "tool",
            "uuid": "uuid-9"
        },
        "10": {
            "annotation": "Diffusion solve (using transient solver as steady)",
            "content_id": "gdps_transient_thermal",
            "id": 10,
            "input_connections": {
                "d_file": {"id": 8, "output_name": "output_d"},
                "dat_file": {"id": 7, "output_name": "output_dat"},
                "fix_file": {"id": 9, "output_name": "output_fix"},
                "mat_file": {"id": 7, "output_name": "output_mat"}
            },
            "inputs": [],
            "label": "8. Diffusion Solver",
            "name": "ParaFEM Transient Thermal Solver",
            "tool_id": "gdps_transient_thermal",
            "tool_state": "{\"nstep\": \"1\", \"dtim\": \"1.0e10\", \"theta\": \"1.0\"}",
            "type": "tool",
            "uuid": "uuid-10"
        },
        "11": {
            "annotation": "Post-process results",
            "content_id": "gdps_parafem2vtu",
            "id": 11,
            "input_connections": {
                "d_file": {"id": 8, "output_name": "output_d"},
                "ensi_tarball": {"id": 10, "output_name": "output_ensi"}
            },
            "inputs": [],
            "label": "9. Final VTU",
            "name": "ParaFEM to VTU (Steady State)",
            "tool_id": "gdps_parafem2vtu",
            "tool_state": "{}",
            "type": "tool",
            "uuid": "uuid-11"
        }
    },
    "uuid": "uuid-main"
}
