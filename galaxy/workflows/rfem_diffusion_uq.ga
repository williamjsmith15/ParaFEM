{
    "a_galaxy_workflow": "true",
    "annotation": "RFEM Diffusion Uncertainty Quantification workflow for GDPS permeation analysis. Models spatially varying hydrogen diffusivity D(x) using a log-normal random field. BCs set from Sievert's law (C_upstream) and zero downstream concentration. Solves Fick's law: div(D grad C) = 0.",
    "format-version": "0.1",
    "name": "RFEM Diffusion UQ - GDPS Permeation (Single Instance)",
    "steps": {
        "0": {
            "annotation": "Generate structured mesh for GDPS permeation sample (5mm x 5mm x 0.5mm membrane, 8x8x8 elements)",
            "content_id": "gdps_rfemcube",
            "errors": null,
            "id": 0,
            "input_connections": {},
            "inputs": [],
            "label": "Generate Membrane Mesh",
            "outputs": [
                {"name": "output_d",   "type": "txt"},
                {"name": "output_dat", "type": "txt"},
                {"name": "output_res", "type": "txt"}
            ],
            "position": {"left": 0, "top": 200},
            "post_job_actions": {},
            "tool_id": "gdps_rfemcube",
            "tool_state": "{\"nels\": \"512\", \"nxe\": \"8\", \"nze\": \"8\", \"aa\": \"6.25e-4\", \"bb\": \"6.25e-4\", \"cc\": \"6.25e-5\", \"thx\": \"0.001\", \"thy\": \"0.001\", \"thz\": \"1.0e-4\", \"emn\": \"1.5e-12\", \"esd\": \"3.0e-13\", \"varfnc\": \"dlavx3\", \"output\": \"1\"}",
            "tool_version": "0.1.0",
            "type": "tool",
            "uuid": "a2b3c4d5-0002-0000-0000-000000000001",
            "workflow_outputs": [
                {"label": "membrane_d",   "output_name": "output_d",   "uuid": "c1000001"},
                {"label": "membrane_dat", "output_name": "output_dat", "uuid": "c1000002"}
            ]
        },
        "1": {
            "annotation": "Apply Dirichlet BCs from Sievert's law. C_upstream = sqrt(p_H2/K_s) [mol/m^3], C_downstream = 0. Typical values: C_up = 4.5e-3 mol/m^3 at 10 MPa H2, 300C, alpha-Fe.",
            "content_id": "gdps_rfembc_thermal",
            "errors": null,
            "id": 1,
            "input_connections": {
                "d_file":   {"id": 0, "output_name": "output_d"},
                "dat_file": {"id": 0, "output_name": "output_dat"}
            },
            "inputs": [],
            "label": "Apply Diffusion BCs (Sievert's Law)",
            "outputs": [
                {"name": "output_fix", "type": "txt"},
                {"name": "output_dat", "type": "txt"},
                {"name": "output_res", "type": "txt"}
            ],
            "position": {"left": 300, "top": 200},
            "post_job_actions": {},
            "tool_id": "gdps_rfembc_thermal",
            "tool_state": "{\"val_upstream\": \"4.5e-3\", \"val_downstream\": \"0.0\"}",
            "tool_version": "0.1.0",
            "type": "tool",
            "uuid": "a2b3c4d5-0002-0000-0000-000000000002",
            "workflow_outputs": [
                {"label": "diffusion_fix",     "output_name": "output_fix", "uuid": "c2000001"},
                {"label": "diffusion_bc_dat",  "output_name": "output_dat", "uuid": "c2000002"}
            ]
        },
        "2": {
            "annotation": "Generate spatially correlated log-normal random diffusivity field. emn=1.5e-12 m^2/s (D_H in alpha-Fe at 300C), esd=3e-13. Correlation length 0.1mm in-plane, 0.01mm through-thickness.",
            "content_id": "gdps_rfemfield_thermal",
            "errors": null,
            "id": 2,
            "input_connections": {
                "d_file":   {"id": 0, "output_name": "output_d"},
                "dat_file": {"id": 1, "output_name": "output_dat"}
            },
            "inputs": [],
            "label": "Generate Random D(x) Field",
            "outputs": [
                {"name": "output_instance", "type": "tar.gz"},
                {"name": "output_res",      "type": "txt"}
            ],
            "position": {"left": 600, "top": 200},
            "post_job_actions": {},
            "tool_id": "gdps_rfemfield_thermal",
            "tool_state": "{\"instance_id\": \"001\", \"nels\": \"512\", \"nxe\": \"8\", \"nze\": \"8\", \"aa\": \"6.25e-4\", \"bb\": \"6.25e-4\", \"cc\": \"6.25e-5\", \"thx\": \"0.001\", \"thy\": \"0.001\", \"thz\": \"1.0e-4\", \"emn\": \"1.5e-12\", \"esd\": \"3.0e-13\", \"varfnc\": \"dlavx3\", \"output\": \"1\"}",
            "tool_version": "0.1.0",
            "type": "tool",
            "uuid": "a2b3c4d5-0002-0000-0000-000000000003",
            "workflow_outputs": [
                {"label": "diffusivity_instance", "output_name": "output_instance", "uuid": "c3000001"},
                {"label": "diffusivity_rf_stats", "output_name": "output_res",      "uuid": "c3000002"}
            ]
        },
        "3": {
            "annotation": "Solve Fick's law: div(D(x) grad C) = 0. Per-element diffusivity from random field. Outputs nodal concentration field C(x) across the membrane.",
            "content_id": "gdps_rfemsolve_thermal",
            "errors": null,
            "id": 3,
            "input_connections": {
                "instance_archive": {"id": 2, "output_name": "output_instance"},
                "fix_file":         {"id": 1, "output_name": "output_fix"}
            },
            "inputs": [],
            "label": "Solve Fick Diffusion",
            "outputs": [
                {"name": "output_res",  "type": "txt"},
                {"name": "output_ensi", "type": "tar.gz"}
            ],
            "position": {"left": 900, "top": 200},
            "post_job_actions": {},
            "tool_id": "gdps_rfemsolve_thermal",
            "tool_state": "{}",
            "tool_version": "0.1.0",
            "type": "tool",
            "uuid": "a2b3c4d5-0002-0000-0000-000000000004",
            "workflow_outputs": [
                {"label": "concentration_field_res",  "output_name": "output_res",  "uuid": "c4000001"},
                {"label": "concentration_field_ensi", "output_name": "output_ensi", "uuid": "c4000002"}
            ]
        }
    },
    "uuid": "rfem-diffusion-uq-gdps-permeation-v1",
    "tags": ["parafem", "rfem", "diffusion", "uq", "gdps", "permeation", "hydrogen"]
}
