<tool id="gdps_compute_diffusivity" name="ParaFEM Diffusivity Field" version="0.1.0">
    <description>Compute temperature-dependent diffusivity field (.mat)</description>
    <requirements>
        <container type="docker">williamjsmith15/parafem-bcgen:latest</container>
    </requirements>
    <command><![CDATA[
        python3 '$__tool_directory__/gdps_compute_diffusivity.py'
            --mesh_d '$mesh_d'
            --dat_file '$dat_file'
            
            #if $material_type.source == "database":
                --material '$material_type.material'
            #else:
                --D0 $material_type.D0
                --Ea $material_type.Ea
            #end if
            
            #if $temp_mode.mode == "scalar":
                --temp_mode scalar
                --temp_scalar $temp_mode.temp_scalar
            #else:
                --temp_mode field
                --temp_field '$temp_mode.temp_field'
            #end if
            
            --output_mat '$output_mat'
            --output_d '$output_d'
            --output_dat '$output_dat'
    ]]></command>
    <inputs>
        <param type="data" name="mesh_d" label="Mesh geometry (.d)" format="txt" />
        <param type="data" name="dat_file" label="Control data (.dat)" format="txt" />
        
        <conditional name="material_type">
            <param name="source" type="select" label="Material Data Source">
                <option value="database" selected="true">Material Database</option>
                <option value="custom">Custom Parameters</option>
            </param>
            <when value="database">
                <param name="material" type="select" label="Select Material">
                    <option value="iron">Iron (Alpha-Fe)</option>
                    <option value="copper">Copper</option>
                    <option value="tungsten">Tungsten</option>
                </param>
            </when>
            <when value="custom">
                <param name="D0" type="float" label="Diffusivity pre-exponential (D0)" value="4.1e-8" help="m^2/s" />
                <param name="Ea" type="float" label="Diffusivity activation energy (Ea)" value="4100.0" help="J/mol" />
            </when>
        </conditional>
        
        <conditional name="temp_mode">
            <param name="mode" type="select" label="Temperature Input Mode">
                <option value="scalar" selected="true">Scalar Temperature (Uniform)</option>
                <option value="field">Temperature Field (from Thermal Solve)</option>
            </param>
            <when value="scalar">
                <param name="temp_scalar" type="float" label="Temperature (K)" value="500.0" />
            </when>
            <when value="field">
                <param name="temp_field" type="data" label="Temperature Field File" format="txt" help="EnSight scalar file (.ensi.NDP*)" />
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data format="txt" name="output_mat" label="Material properties (.mat)" />
        <data format="txt" name="output_d" label="Modified mesh (.d)" />
        <data format="txt" name="output_dat" label="Modified control data (.dat)" />
    </outputs>
    <help>
Computes temperature-dependent diffusivity for each element in the mesh.
D(T) = D0 * exp(-Ea / RT)

This tool generates:
1. A .mat file with unique material properties for each element.
2. A modified .d file where each element is assigned its unique material ID.
3. A modified .dat file with the correct number of property types.

The resulting files can be used with p124 or gdps_thermal_transient for diffusion simulation.
    </help>
</tool>
