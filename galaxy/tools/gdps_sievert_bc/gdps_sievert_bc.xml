<tool id="gdps_sievert_bc" name="ParaFEM Sievert's Law BC" version="0.1.0">
    <description>Convert pressure BCs to concentration BCs using Sievert's Law</description>
    <requirements>
        <container type="docker">williamjsmith15/parafem-bcgen:latest</container>
    </requirements>
    <command><![CDATA[
        python3 '$__tool_directory__/gdps_sievert_bc.py'
            --mesh_d '$mesh_d'
            --nset_file '$nset_file'
            --upstream_nset '$upstream_nset'
            --downstream_nset '$downstream_nset'
            
            #if $material_type.source == "database":
                --material '$material_type.material'
            #else:
                --S0 $material_type.S0
                --Es $material_type.Es
            #end if
            
            #if $temp_mode.mode == "scalar":
                --temp_mode scalar
                --temp_scalar $temp_mode.temp_scalar
            #else:
                --temp_mode field
                --temp_field '$temp_mode.temp_field'
            #end if
            
            #if $pressure_type.type == "static":
                --upstream_p $pressure_type.upstream_p
                --downstream_p $pressure_type.downstream_p
                --output_fix '$output_fix'
            #else:
                --pressure_schedule '$pressure_file'
                --output_bcs '$output_bcs'
            #end if
    ]]></command>
    <configfiles>
        <configfile name="pressure_file">
#if $pressure_type.type == "scheduled":
${pressure_type.pressure_schedule}
#end if
        </configfile>
    </configfiles>
    <inputs>
        <param type="data" name="mesh_d" label="Mesh geometry (.d)" format="txt" />
        <param type="data" name="nset_file" label="Node sets (.nset)" format="txt" />
        <param type="text" name="upstream_nset" label="Upstream NSET name" value="UPSTREAM_FACE" />
        <param type="text" name="downstream_nset" label="Downstream NSET name" value="DOWNSTREAM_FACE" />
        
        <conditional name="material_type">
            <param name="source" type="select" label="Material Data Source">
                <option value="database" selected="true">Material Database</option>
                <option value="custom">Custom Parameters</option>
            </param>
            <when value="database">
                <param name="material" type="select" label="Select Material">
                    <option value="iron">Iron (Alpha-Fe)</option>
                    <option value="copper">Copper</option>
                    <option value="tungsten">Tungsten</option>
                </param>
            </when>
            <when value="custom">
                <param name="S0" type="float" label="Solubility pre-exponential (S0)" value="5.1e-3" help="mol/(m^3*Pa^0.5)" />
                <param name="Es" type="float" label="Solubility activation energy (Es)" value="28600.0" help="J/mol" />
            </when>
        </conditional>
        
        <conditional name="temp_mode">
            <param name="mode" type="select" label="Temperature Input Mode">
                <option value="scalar" selected="true">Scalar Temperature (Uniform)</option>
                <option value="field">Temperature Field (from Thermal Solve)</option>
            </param>
            <when value="scalar">
                <param name="temp_scalar" type="float" label="Temperature (K)" value="500.0" />
            </when>
            <when value="field">
                <param name="temp_field" type="data" label="Temperature Field File" format="txt" help="EnSight scalar file (.ensi.NDP*)" />
            </when>
        </conditional>
        
        <conditional name="pressure_type">
            <param name="type" type="select" label="Pressure Mode">
                <option value="static" selected="true">Static Pressures</option>
                <option value="scheduled">Scheduled Pressures (Time-Varying)</option>
            </param>
            <when value="static">
                <param name="upstream_p" type="float" label="Upstream Pressure (Pa)" value="100000.0" />
                <param name="downstream_p" type="float" label="Downstream Pressure (Pa)" value="0.0" />
            </when>
            <when value="scheduled">
                <param name="pressure_schedule" type="text" area="true" label="Pressure Schedule (JSON)" 
                       value='[{"step": 1, "upstream_p": 100000.0, "downstream_p": 0.0}, {"step": 10, "upstream_p": 200000.0, "downstream_p": 0.0}]'
                       help="JSON array of steps with upstream_p and downstream_p">
                    <sanitizer>
                        <valid initial="string.printable"/>
                    </sanitizer>
                </param>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data format="txt" name="output_fix" label="Fixed concentrations (.fix)">
            <filter>pressure_type['type'] == 'static'</filter>
        </data>
        <data format="txt" name="output_bcs" label="Concentration schedule (.bcs)">
            <filter>pressure_type['type'] == 'scheduled'</filter>
        </data>
    </outputs>
    <help>
Converts gas pressure (Pa) at boundaries to concentration (mol/m^3) using Sievert's Law:
C = S(T) * sqrt(P)

Where solubility S(T) follows the Arrhenius relation:
S(T) = S0 * exp(-Es / RT)

This tool generates a ParaFEM .fix file (for static pressures) or a .bcs file (for time-varying pressures).
    </help>
</tool>
